<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hz.dream.dao.PropertyListingMapper">

    <resultMap id="propertyListingMap" type="com.hz.dream.po.PropertyListing">
        <id     property="id"            column="id"/>
        <result property="tenantId"      column="tenant_id"/>
        <result property="propertyId"    column="property_id"/>
        <result property="listingPrice"  column="listing_price"/>
        <result property="listingTime"   column="listing_time"/>
        <result property="remark"        column="remark"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateTime"    column="update_time"/>
    </resultMap>

    <sql id="cols">id, tenant_id, property_id, listing_price, listing_time, remark, create_time, update_time</sql>

    <select id="getById" resultMap="propertyListingMap">
        SELECT <include refid="cols"/>
        FROM   property_listings
        WHERE  id        = #{id}
        AND    tenant_id = #{tenantId}
    </select>

    <select id="listByProperty" resultMap="propertyListingMap">
        SELECT <include refid="cols"/>
        FROM   property_listings
        WHERE  property_id = #{propertyId}
        AND    tenant_id   = #{tenantId}
        ORDER  BY listing_time DESC
    </select>

    <insert id="insertSelective" parameterType="com.hz.dream.po.PropertyListing">
        INSERT INTO property_listings
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="propertyId != null">property_id,</if>
            <if test="listingPrice != null">listing_price,</if>
            <if test="listingTime != null">listing_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="propertyId != null">#{propertyId},</if>
            <if test="listingPrice != null">#{listingPrice},</if>
            <if test="listingTime != null">#{listingTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSelectiveById" parameterType="com.hz.dream.po.PropertyListing">
        UPDATE property_listings
        <set>
            <if test="listingPrice != null">listing_price = #{listingPrice},</if>
            <if test="listingTime != null">listing_time = #{listingTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id        = #{id}
        AND   tenant_id = #{tenantId}
    </update>

    <delete id="deleteById">
        DELETE FROM property_listings WHERE id = #{id} AND tenant_id = #{tenantId}
    </delete>

</mapper>
